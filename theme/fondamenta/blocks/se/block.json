{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fondamenta/se",
	"title": "Se c'è",
	"category": "theme",
	"description": "Mostra i suoi blocchi solo se un valore del contenuto mostrato c'è (o, al contrario, se manca), oppure se i confronti con valori scritti sono veri.",
	"textdomain": "fondamenta",
	"attributes": {
		"legame": {
			"type": "object",
			"default": {}
		},
		"vuoto": {
			"type": "boolean",
			"default": false
		},
		"confronto": {
			"type": "string",
			"enum": [
				"",
				"pieno",
				"==",
				"!=",
				">",
				">=",
				"<",
				"<=",
				"contiene"
			],
			"default": ""
		},
		"valore": {
			"type": "string",
			"default": ""
		},
		"oppure": {
			"type": "array"
		}
	},
	"usesContext": [
		"postId",
		"postType",
		"fondamenta/voce"
	],
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"editorScript": "fondamenta-editor",
	"editorStyle": "fondamenta-editor"
}
