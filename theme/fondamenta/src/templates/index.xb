<!-- wp:template-part {"slug":"header","tagName":"div"} /-->
<main id="main" class="site-main">
  {@content}
  {#loop main() as post}
    <article class="entry entry--summary">
      <h2 class="entry__title"><a href={post.url}>{post.title}</a></h2>
      {#if post.excerpt}
        <p class="entry__excerpt">{post.excerpt}</p>
      {/if}
    </article>
  {/loop}
</main>
<!-- wp:template-part {"slug":"footer","tagName":"div"} /-->
