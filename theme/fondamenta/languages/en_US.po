#. Theme Name of the theme
#: style.css
msgid "Fondamenta"
msgstr "Fondamenta"

#. Description of the theme
#: style.css
msgid "Tema a blocchi di base. Con il costruttore attivo non aggiunge nulla e lascia disegnare lui; senza, dice in amministrazione cosa manca. Prende il posto di XB Blank."
msgstr "Base block theme. With the builder active it adds nothing and lets the builder draw; without it, it tells the administrator what is missing. It takes the place of XB Blank."

#. translators: %d: number of pages, posts and other contents
#, php-format
#: functions.php:115
msgid "%d contenuto è fatto con i suoi blocchi e ora non mostra nulla."
msgid_plural "%d contenuti sono fatti con i suoi blocchi e ora non mostrano nulla."
msgstr[0] "%d content is made with its blocks and now shows nothing."
msgstr[1] "%d contents are made with its blocks and now show nothing."

#: functions.php:118
msgid "I template e le parti di Fondamenta usano gli stessi blocchi: il sito pubblico resta senza testata, piè di pagina e contenuto."
msgstr "Fondamenta's templates and parts use the same blocks: the public site is left without header, footer and content."

#. translators: %s: names of content types, separated by commas
#, php-format
#: functions.php:122
msgid "I tipi di contenuto %s non sono registrati: i loro contenuti restano nel database ma non hanno un indirizzo."
msgstr "The content types %s are not registered: their contents stay in the database but have no address."

#: functions.php:125
msgid "Gli stili del sito non vengono stampati."
msgstr "The site's styles are not printed."

#: functions.php:128
msgid "Per convertire queste pagine nei blocchi di Fondamenta serve il plugin attivo: riattivalo."
msgstr "Converting these pages into Fondamenta's blocks needs the plugin active: activate it again."

#. translators: %s: plugin name
#, php-format
#: functions.php:133
msgid "Fondamenta è ferma: il plugin «%s», che disegna le pagine di questo sito, non è attivo."
msgstr "Fondamenta is stopped: the plugin “%s”, which draws the pages of this site, is not active."

#: functions.php:134
msgid "Fondamenta è ferma: il plugin che disegna le pagine di questo sito (cartella «xb») non è installato."
msgstr "Fondamenta is stopped: the plugin that draws the pages of this site (folder “xb”) is not installed."

#: functions.php:141
msgid "Vai ai plugin"
msgstr "Go to plugins"

