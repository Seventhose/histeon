#. Plugin Name of the plugin
#: histos-css.php
msgid "Histeon CSS"
msgstr "Histeon CSS"

#. Description of the plugin
#: histos-css.php
msgid "Il framework CSS libero di Histeon, per qualsiasi sito WordPress: token fluidi, palette OKLCH, classi, recipes, il pannello in popup (Alt+Maiusc+H) e la palette nell'editor a blocchi. Nessuna licenza."
msgstr "Histeon’s free CSS framework, for any WordPress site: fluid tokens, OKLCH palette, classes, recipes, the popup panel (Alt+Shift+H) and the palette in the block editor. No license keys."

#. Author of the plugin
#: histos-css.php
msgid "Histeon"
msgstr "Histeon"

